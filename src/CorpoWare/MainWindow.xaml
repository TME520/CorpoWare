<Window x:Class="CorpoWare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CorpoWare"
        Height="720"
        Width="1120"
        MinHeight="560"
        MinWidth="900"
        Background="{StaticResource App.Background}"
        FontFamily="Segoe UI"
        FontSize="14"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top"
            Background="{StaticResource App.Surface}"
            BorderBrush="{StaticResource App.Border}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock x:Name="VersionText"
                     HorizontalAlignment="Right"
                     Foreground="{StaticResource App.Muted}"
                     FontSize="12" />
          <TextBlock Text="Portable · Windows 11"
                     HorizontalAlignment="Right"
                     Foreground="{StaticResource App.Muted}"
                     FontSize="12"
                     Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="CorpoWare"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource App.Text}" />
          <TextBlock Text="Work that never made it into Jira"
                     Foreground="{StaticResource App.Muted}"
                     FontSize="12"
                     Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="{StaticResource App.Surface}"
            BorderBrush="{StaticResource App.Border}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
      <TextBlock x:Name="DataPathText"
                 Foreground="{StaticResource App.Muted}"
                 FontSize="12"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <Border DockPanel.Dock="Left"
            Width="200"
            Background="{StaticResource App.Surface}"
            BorderBrush="{StaticResource App.Border}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="WORKSPACE"
                   Margin="16,16,16,8"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource App.Muted}" />
        <ListBox x:Name="NavList"
                 AutomationProperties.Name="Sections"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="8,0,8,12"
                 SelectionChanged="OnNavSelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="12,10" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="#F0F3F7" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource App.AccentSoft}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource App.Accent}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBoxItem Tag="impromptu">
            <TextBlock Text="Impromptu" FontWeight="SemiBold" />
          </ListBoxItem>
          <ListBoxItem Tag="kanban">
            <TextBlock Text="Kanban" FontWeight="SemiBold" />
          </ListBoxItem>
          <ListBoxItem Tag="routines">
            <TextBlock Text="Routines" FontWeight="SemiBold" />
          </ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <ContentControl x:Name="PageHost" />
  </DockPanel>
</Window>
