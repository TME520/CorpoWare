<UserControl x:Class="CorpoWare.Views.ImpromptuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="480">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Impromptu inbox"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource App.Text}" />
      <TextBlock Text="Slack DMs, email, and walk-in asks that never became a ticket."
                 Foreground="{StaticResource App.Muted}"
                 Margin="0,4,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock x:Name="EmptyText"
               DockPanel.Dock="Top"
               Text="Nothing in the inbox yet."
               Foreground="{StaticResource App.Muted}"
               Margin="0,12,0,0"
               Visibility="Collapsed" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ItemList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource App.Surface}"
                    BorderBrush="{StaticResource App.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Source}"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource App.Accent}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AskedBy}"
                             Foreground="{StaticResource App.Muted}"
                             FontSize="12"
                             Margin="0,4,0,0"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}"
                             Foreground="{StaticResource App.Muted}"
                             FontSize="12"
                             Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                  <TextBlock Text="{Binding Title}"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource App.Text}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Context}"
                             Foreground="{StaticResource App.Muted}"
                             Margin="0,4,0,0"
                             TextWrapping="Wrap" />
                  <TextBlock Margin="0,8,0,0"
                             FontSize="12"
                             Foreground="{StaticResource App.Text}"
                             TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding FollowUpNote}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                    <Run Text="Follow-up: " />
                    <Run Text="{Binding FollowUpNote}" />
                  </TextBlock>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
