<UserControl x:Class="CorpoWare.Views.KanbanColumnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{StaticResource App.Surface}"
          BorderBrush="{StaticResource App.Border}"
          BorderThickness="1"
          CornerRadius="8">
    <DockPanel>
      <Border x:Name="HeaderBorder"
              DockPanel.Dock="Top"
              BorderBrush="{StaticResource App.Border}"
              BorderThickness="0,3,0,1"
              Padding="12,10">
        <DockPanel>
          <TextBlock x:Name="CountText"
                     DockPanel.Dock="Right"
                     Foreground="{StaticResource App.Muted}"
                     FontSize="12"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="TitleText"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource App.Text}" />
        </DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock x:Name="EmptyText"
                     Text="Nothing in this column yet."
                     Foreground="{StaticResource App.Muted}"
                     FontSize="12"
                     Margin="12"
                     TextWrapping="Wrap"
                     Visibility="Collapsed" />
          <ItemsControl x:Name="CardList" Margin="8,8,8,4">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource App.Card}"
                        BorderBrush="{StaticResource App.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource App.Text}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}"
                               Foreground="{StaticResource App.Muted}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
