<Application x:Class="CorpoWare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="App.Background" Color="#F4F6F8" />
    <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Border" Color="#E1E5EA" />
    <SolidColorBrush x:Key="App.Text" Color="#1C2430" />
    <SolidColorBrush x:Key="App.Muted" Color="#5C6B7A" />
    <SolidColorBrush x:Key="App.Accent" Color="#1F5FBF" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#E7F0FB" />
    <SolidColorBrush x:Key="App.Card" Color="#F7F9FB" />
  </Application.Resources>
</Application>
